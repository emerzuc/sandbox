## This file must be in your .gitignore to protect your keys.
## Copy this file to 'local.properties' and fill in your API keys.

# Android SDK path (Auto-generated by Android Studio)
# sdk.dir=/path/to/android/sdk

# TMDB API Key
# Get your key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API-Football Key
# Get your key at: https://www.api-football.com/
FOOTBALL_API_KEY=your_football_api_key_here
